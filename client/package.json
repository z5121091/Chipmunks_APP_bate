{
  "name": "chipmunks-warehouse",
  "version": "1.0.0",
  "description": "掌上仓库 APP - 移动端仓储管理系统",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "check-deps": "npx depcheck",
    "install-missing": "node ./scripts/install-missing-deps.js",
    "lint": "eslint app components screens hooks utils constants",
    "typecheck": "tsc --noEmit",
    "start": "expo start --web --offline --clear",
    "test": "jest --watchAll",
    "test:ci": "jest --runInBand",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "<rootDir>/jest-resolver.cjs",
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.cjs"],
    "testTimeout": 30000
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.15.2",
    "dayjs": "^1.11.19",
    "expo": "57.0.24",
    "expo-build-properties": "~57.0.21",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-sharing": "~57.0.21",
    "expo-speech": "^57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "js-base64": "^3.7.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "uniwind": "^1.6.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.27.0",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.18",
    "@types/react-test-renderer": "19.1.0",
    "autoprefixer": "^10.5.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "^57.0.12",
    "chalk": "^4.1.2",
    "connect": "^3.7.0",
    "depcheck": "^1.4.7",
    "esbuild": "0.27.2",
    "eslint": "^9.39.2",
    "eslint-formatter-compact": "^9.0.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-regexp": "^2.10.0",
    "globals": "^16.1.0",
    "http-proxy-middleware": "^3.0.5",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.5",
    "postcss": "^8.5.10",
    "react-test-renderer": "19.2.3",
    "serve": "^14.2.6",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}

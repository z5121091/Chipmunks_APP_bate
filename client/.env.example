# Shared Coze proxy URL. Both accounts can use the same frontend backend URL;
# X-Erp-Account-Key selects the actual ERP server behind the proxy.
EXPO_PUBLIC_BACKEND_BASE_URL=https://erp.chipmunks.fun

# Coze Web and Coze-built APKs call the public ERP gateway directly instead of
# asking the Coze backend sandbox to access the Internet.
EXPO_PUBLIC_ERP_USE_PUBLIC_GATEWAY=true
EXPO_PUBLIC_ERP_PUBLIC_GATEWAY_BASE_URL=https://erp.chipmunks.fun

# Direct-backend test builds may send this key. Do not treat an EXPO_PUBLIC value
# as a long-term production secret; production should place a trusted gateway in front.
EXPO_PUBLIC_BACKEND_ACCESS_KEY=

# Optional direct-backend overrides for local/native testing.
EXPO_PUBLIC_ERP_WUXI_DUNENG_BASE_URL=
EXPO_PUBLIC_ERP_SHANGHAI_CHIPMUNK_BASE_URL=

EXPO_PUBLIC_ERP_WUXI_DUNENG_ENABLED=true
EXPO_PUBLIC_ERP_SHANGHAI_CHIPMUNK_ENABLED=true

# Internal APKs keep the in-app updater. Set false for app-store builds to hide
# the updater and remove android.permission.REQUEST_INSTALL_PACKAGES at prebuild.
EXPO_PUBLIC_ENABLE_SELF_UPDATE=true

# Build-time WebDAV/update address. Keep credentials in the build environment,
# not in update-server.json or version.json.
UPDATE_SERVER_URL=https://username:password@example.com/AppUpdate

NODE_ENV=development
HOST=0.0.0.0
PORT=8080

CHANJET_APP_KEY=
CHANJET_APP_SECRET=
CHANJET_CHECK_CONTENT=
CHANJET_MESSAGE_SECRET=
CHANJET_CERTIFICATE=
CHANJET_APP_TICKET=
# Prefer one public base URL per account instance. The callback defaults to
# <baseUrl>/api/erp/auth/callback; CHANJET_REDIRECT_URI remains an optional override.
CHANJET_PUBLIC_BASE_URL=http://localhost:8080
CHANJET_REDIRECT_URI=
CHANJET_ALLOW_PLAINTEXT_MESSAGES=false

# Publicly reachable ERP and upload routes require BACKEND_ACCESS_KEY. Configure
# the same value as BACKEND_PROXY_ACCESS_KEY on a trusted Coze proxy target.
# Local loopback development may omit it; public and reverse-proxy traffic may not.
BACKEND_ACCESS_KEY=
BACKEND_ADMIN_KEY=
# Account-specific proxy keys are preferred. BACKEND_PROXY_ACCESS_KEY remains a
# legacy fallback and must match BACKEND_ACCESS_KEY on every target that uses it.
BACKEND_PROXY_ACCESS_KEY_WUXI_DUNENG=
BACKEND_PROXY_ACCESS_KEY_SHANGHAI_CHIPMUNK=
BACKEND_PROXY_ACCESS_KEY=

# Local ERP server mode: false. Coze/standalone routing proxy mode: true.
CHANJET_PROXY_MODE=false

# Optional server address fallback for environments whose DNS cannot resolve
# the ERP domain. HTTPS still validates the hostname from CHANJET_PROXY_TARGET_*.
# Update or remove the address when migrating the corresponding ERP server.
CHANJET_PROXY_ADDRESS_WUXI_DUNENG=
CHANJET_PROXY_ADDRESS_SHANGHAI_CHIPMUNK=

# Client-to-Coze-proxy guard. When configured, the client must send the same
# value through EXPO_PUBLIC_BACKEND_ACCESS_KEY. Existing Coze builds may leave
# this empty temporarily: only /api/v1/tplus-proxy then uses a stricter
# rate-limited compatibility mode, so it will not regress to 401/404.
COZE_PROXY_KEYLESS_RATE_LIMIT_MAX=120
COZE_PROXY_KEYLESS_RATE_LIMIT_WINDOW_MS=3600000
COZE_PROXY_CLIENT_ACCESS_KEY=
COZE_PROXY_ALLOW_KEYLESS_COMPATIBILITY=true

# Every ERP process owns exactly one company account and one independent state file.
# One physical server can run two processes from the same build with separate
# EnvironmentFile values and ports; see server/deploy/README.md.
# CHANJET_STATE_DIR is the state root; the server creates <root>/<accountKey>/chanjet-state.json.
# Set shanghai-chipmunk on the Shanghai process. Proxy-only processes do not need
# local Chanjet credentials.
CHANJET_LOCAL_ACCOUNT_KEY=wuxi-duneng
CHANJET_ORG_ID=
CHANJET_STATE_DIR=
UPLOAD_DIR=

# Coze routes requests by X-Erp-Account-Key. Server migration only requires
# changing these URLs; frontend business paths remain unchanged.
CHANJET_PROXY_TARGET_WUXI_DUNENG=
CHANJET_PROXY_TARGET_SHANGHAI_CHIPMUNK=

# Legacy single-account fallback. Keep only while older deployments still use it.
CHANJET_PROXY_TARGET=

# Comma-separated browser origins. Native apps and server-side proxies do not send Origin.
CORS_ORIGINS=
CORS_ALLOW_LOCALHOST=true
CORS_ALLOW_COZE=true

# Optional defaults for local ERP API testing.
CHANJET_APP_NAME=tpluscloud
CHANJET_SCOPE=auth_all
CHANJET_OPEN_TOKEN=
CHANJET_SID=

# Each account instance refreshes only the refreshToken in its own state file.
# Defaults renew roughly one day before the six-day openToken expires and never
# let a token set go more than five days without a successful refresh.
CHANJET_AUTO_REFRESH_ENABLED=true
CHANJET_AUTO_REFRESH_LEAD_HOURS=24
CHANJET_AUTO_REFRESH_MAX_AGE_HOURS=120
CHANJET_AUTO_REFRESH_CHECK_MINUTES=60

# Set to true only if the OAuth callback should immediately exchange code for token.
CHANJET_EXCHANGE_ON_CALLBACK=false

# Usually keep these defaults.
CHANJET_OPENAPI_BASE_URL=https://openapi.chanjet.com
CHANJET_MARKET_BASE_URL=https://market.chanjet.com
CHANJET_HTTP_CONNECT_TIMEOUT_SECONDS=5
CHANJET_HTTP_TIMEOUT_SECONDS=18
# auto: reuse connections for read-only ERP queries; curl: compatibility rollback.
# When HTTP(S)/ALL_PROXY is configured, auto preserves the existing curl proxy behavior.
CHANJET_HTTP_TRANSPORT=auto
ERP_PROXY_TIMEOUT_MS=22000

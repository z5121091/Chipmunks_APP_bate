# Install as /etc/palm-warehouse/erp/shanghai-chipmunk.env and set mode 0600.
NODE_ENV=production
HOST=127.0.0.1
PORT=18082

CHANJET_PROXY_MODE=false
CHANJET_LOCAL_ACCOUNT_KEY=shanghai-chipmunk
CHANJET_ORG_ID=
CHANJET_APP_KEY=
CHANJET_APP_SECRET=
CHANJET_MESSAGE_SECRET=
CHANJET_CERTIFICATE=
CHANJET_CHECK_CONTENT=
CHANJET_PUBLIC_BASE_URL=https://erp-shanghai.example.com
CHANJET_REDIRECT_URI=
CHANJET_ALLOW_PLAINTEXT_MESSAGES=false

# This is a common root. The application writes
# /var/lib/palm-warehouse/erp-state/shanghai-chipmunk/chanjet-state.json.
CHANJET_STATE_DIR=/var/lib/palm-warehouse/erp-state
UPLOAD_DIR=/var/lib/palm-warehouse/uploads/shanghai-chipmunk

BACKEND_ACCESS_KEY=
BACKEND_ADMIN_KEY=
CORS_ORIGINS=
CORS_ALLOW_LOCALHOST=false

CHANJET_APP_NAME=tpluscloud
CHANJET_SCOPE=auth_all
CHANJET_OPEN_TOKEN=
CHANJET_SID=
CHANJET_AUTO_REFRESH_ENABLED=true
CHANJET_AUTO_REFRESH_LEAD_HOURS=24
CHANJET_AUTO_REFRESH_MAX_AGE_HOURS=120
CHANJET_AUTO_REFRESH_CHECK_MINUTES=60
CHANJET_EXCHANGE_ON_CALLBACK=false
CHANJET_OPENAPI_BASE_URL=https://openapi.chanjet.com
CHANJET_MARKET_BASE_URL=https://market.chanjet.com
